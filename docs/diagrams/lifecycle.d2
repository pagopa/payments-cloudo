shape: sequence_diagram

caller: "Caller\nUI, API, alert, schedule"
orch: "Orchestrator"
approver: "Approver\nsame team or admin"
queue: "Worker queue"
worker: "Worker"
recv: "Receiver"
notify: "Slack / JSM"
agent: "AI agent"

caller -> orch: "1. Trigger schema id"
orch -> orch: "2. Check team access,\nschema enabled, pick worker"
orch -> notify: "3. If approval required:\nnotify the owning team"
approver -> orch: "4. Approve or reject\n(signed link, expires)"
orch -> queue: "5. Enqueue run for the\nmatching pool and team"
queue -> worker: "6. Pick up the message"
worker -> recv: "7. running"
worker -> worker: "8. Execute the runbook\n(bash or python)"
worker -> recv: "9. succeeded / failed + output"
recv -> recv: "10. Store log row,\nupload output"
recv -> notify: "11. Smart routing:\nSlack, and JSM if on call"
recv -> agent: "12. Failed runs only:\nasync AI triage"
agent -> notify: "13. Triage note on the alert"
